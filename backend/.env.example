# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hrm_reward_system?retryWrites=true&w=majority

# JWT Configuration
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_change_this_in_production
ACCESS_TOKEN_EXPIRY=1d

REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_change_this_in_production
REFRESH_TOKEN_EXPIRY=10d

# Bcrypt Salt Rounds
BCRYPT_ROUNDS=10

# Email Configuration (Nodemailer)
BREVO_API_KEY=your_brevo_api_key_here
SMTP_FROM_EMAIL="Your Company <noreply@company.com>"

# AI Configuration (Gemini API)
GENAI_API_KEY=your_google_gemini_api_key_here
GENAI_MODEL=gemini-2.5-flash

# CORS Configuration
# Development URLs
FRONTEND_URL_DEV=http://localhost:5173
# Production URLs
FRONTEND_URL_PROD=https://yourdomain.vercel.app
# Allowed origins (can be either single origin or comma-separated list)
CORS_ALLOWED_ORIGINS=https://yourdomain.vercel.app,http://localhost:5173

# API Documentation
API_BASE_URL=http://localhost:5000
API_VERSION=v1

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
